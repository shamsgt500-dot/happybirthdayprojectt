<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy Birthday 🎂</title>
<link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Hind+Siliguri:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg1:#ff9ecd;--bg2:#ffd166;--card:#fffffff0;--text:#3b1f3a;--accent:#d6336c;--line:#f3c6dc;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg1:#3a1252;--bg2:#7a1f4d;--card:#2a1a36f0;--text:#fbeaf5;--accent:#ff6fa8;--line:#5b3470;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:linear-gradient(160deg,var(--bg1),var(--bg2));background-attachment:fixed;color:var(--text);font-family:"Hind Siliguri","Noto Sans Bengali",system-ui,sans-serif;line-height:1.6}
.wrap{max-width:820px;margin:0 auto;padding:0 16px 40px}
.menu{display:flex;gap:8px;overflow-x:auto;padding:12px 0;position:sticky;top:env(safe-area-inset-top,0px);z-index:5}
.menu a{white-space:nowrap;background:var(--card);color:var(--text);padding:8px 16px;border-radius:999px;text-decoration:none;font-weight:600;font-size:.95rem}
.menu a.on{background:var(--accent);color:#fff}
.page{display:none;animation:pop .4s}
.page.show{display:block}
@keyframes pop{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
h1,h2{font-family:Pacifico,cursive;font-weight:400;color:var(--accent);margin:.3em 0}
h1{font-size:clamp(2.4rem,10vw,4.2rem);text-align:center}
.box{background:var(--card);border-radius:20px;padding:22px;margin:14px 0;box-shadow:0 6px 20px rgba(0,0,0,.12)}
.center{text-align:center}
.big{font-size:4rem}
.btn{display:inline-block;border:0;cursor:pointer;background:var(--accent);color:#fff;padding:12px 24px;border-radius:999px;font:600 1rem inherit;font-family:inherit;text-decoration:none}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.pic{background:var(--card);border-radius:16px;padding:10px;text-align:center;transform:rotate(-2deg)}
.pic:nth-child(even){transform:rotate(2deg)}
.pic .ph{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:2.4rem;background:var(--line);border-radius:10px;overflow:hidden}
.pic img{width:100%;height:100%;object-fit:cover}
.pic p{margin:8px 0 0;font-size:.9rem}
.fact{border-left:5px solid var(--accent);padding-left:12px;margin:12px 0}
.cake{font-size:5rem;position:relative}
.flame{display:inline-block;animation:fl .5s infinite alternate}
.out .flame{opacity:0;animation:none}
@keyframes fl{from{transform:scale(1)}to{transform:scale(1.25)}}
.conf{position:fixed;top:-30px;font-size:1.6rem;pointer-events:none;animation:fall 3s linear forwards;z-index:9}
@keyframes fall{to{transform:translateY(110vh) rotate(360deg)}}
</style>
</head>
<body>
<div class="wrap">
<nav class="menu" id="menu">
<a href="#home">🏠 Home</a><a href="#memories">📸 Memories</a><a href="#funny">😂 Funny</a><a href="#wishes">💌 Wishes</a><a href="#cake">🎂 Cake</a>
</nav>

<section class="page" id="home">
<div class="box center">
<div class="big">🎉</div>
<h1>Happy Birthday!</h1>
<h2>তোমার নাম</h2>
<p>আজ শুধু তোমার দিন! খাওয়া, হাসি আর ছবি তোলা ছাড়া আজ আর কোনো কাজ নেই 😎</p>
<a class="btn" href="#memories">সারপ্রাইজ দেখো 👉</a>
</div>
</section>

<section class="page" id="memories">
<h2>Our Memories</h2>
<div class="grid">
<div class="pic"><div class="ph">📸</div><p>সেই দিন যেদিন তুমি হাসতে হাসতে পড়ে গিয়েছিলে</p></div>
<div class="pic"><div class="ph">📸</div><p>এই ছবিতে তুমি কিছু একটা খাচ্ছো (যথারীতি)</p></div>
<div class="pic"><div class="ph">📸</div><p>সেলফি, ১৭ বারের চেষ্টায়</p></div>
<div class="pic"><div class="ph">📸</div><p>ঘুরতে গিয়ে হারিয়ে যাওয়ার দিন</p></div>
<div class="pic"><div class="ph">📸</div><p>চোখ বন্ধ, কিন্তু ছবিটা দারুণ</p></div>
<div class="pic"><div class="ph">📸</div><p>আমাদের সবচেয়ে ভালো ছবি</p></div>
</div>
</section>

<section class="page" id="funny">
<h2>Funny Facts</h2>
<div class="box">
<div class="fact">আজ তোমার বয়স এক বছর বাড়লো, কিন্তু আক্কেল বাড়েনি 😜</div>
<div class="fact">তুমি এতই ভালো যে তোমাকে নিয়ে মিথ্যা বলতেও কষ্ট হয় 🤭</div>
<div class="fact">জন্মদিনে ডায়েট বন্ধ। কেক নিয়ম মানে না 🍰</div>
<div class="fact">তোমার হাসি শুনলে আশপাশের সবাই বুঝে যায়, তুমি এসেছো 😂</div>
<div class="fact">ট্রিট না দিলে এই ওয়েবসাইট আর খুলবে না 😈</div>
</div>
</section>

<section class="page" id="wishes">
<h2>Birthday Wishes</h2>
<div class="box">💖 তোমার সব স্বপ্ন সত্যি হোক, শুধু আমার ট্রিটের স্বপ্নটা বাদে না!</div>
<div class="box">🌟 সবসময় এমন হাসিখুশি থেকো। তোমার জন্য অনেক ভালোবাসা ও শুভকামনা।</div>
<div class="box">🎁 আজকের দিনটা হোক তোমার জীবনের সবচেয়ে সুন্দর দিনগুলোর একটা।</div>
</section>

<section class="page" id="cake">
<div class="box center" id="cakebox">
<h2>Make a Wish!</h2>
<div class="cake"><span class="flame">🔥</span><br>🎂</div>
<p>মনে মনে একটা ইচ্ছা করো, তারপর ফুঁ দাও 😌</p>
<button class="btn" id="blow">🌬️ ফুঁ দাও</button>
</div>
</section>
</div>

<script>
var pages=["home","memories","funny","wishes","cake"];
function route(){
  var h=(location.hash||"#home").slice(1);
  if(pages.indexOf(h)<0)h="home";
  pages.forEach(function(p){document.getElementById(p).classList.toggle("show",p===h)});
  document.querySelectorAll("#menu a").forEach(function(a){a.classList.toggle("on",a.getAttribute("href")==="#"+h)});
  window.scrollTo(0,0);
}
function confetti(){
  var e=["🎉","🎊","🎈","✨","🎂"];
  for(var i=0;i<30;i++){
    var s=document.createElement("span");
    s.className="conf";s.textContent=e[i%e.length];
    s.style.left=Math.random()*100+"vw";
    s.style.animationDelay=Math.random()*1.2+"s";
    document.body.appendChild(s);
    setTimeout(function(x){x.remove()},4500,s);
  }
}
document.getElementById("blow").addEventListener("click",function(){
  document.getElementById("cakebox").classList.add("out");
  this.textContent="🎉 Happy Birthday!";
  confetti();
});
window.addEventListener("hashchange",route);
route();
</script>
</body>
</html>
